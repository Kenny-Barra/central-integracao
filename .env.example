# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser commitado (ja esta no .gitignore).

# Token pessoal do Airtable (https://airtable.com/create/tokens)
# Escopos: data.records:read e data.records:write, com acesso a base abaixo
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=app78Cm7BMlZ0RrJ0

# Chave exigida nas rotas de escrita da Central (sincronizar, resolver alerta)
APP_API_KEY=troque-esta-chave

# Limites das automacoes
LIMITE_DOLAR=5.00
LIMITE_TEMP_MAX=35
LIMITE_TEMP_MIN=5
LIMITE_CHUVA_MM=10

# Cidades monitoradas (nome:lat:lon separados por ;)
CIDADES=São Paulo:-23.55:-46.63;Rio de Janeiro:-22.91:-43.17;Curitiba:-25.43:-49.27

# Pares de moeda da AwesomeAPI, separados por virgula
MOEDAS=USD-BRL,EUR-BRL,BTC-BRL
